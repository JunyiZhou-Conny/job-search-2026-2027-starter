# Copy to secrets/.env and fill locally. Never commit secrets/.env
# Do not paste passwords into Cursor chat — put them here on disk only.

SIMPLIFY_EMAIL=you@example.com
SIMPLIFY_PASSWORD=

# Optional: after first interactive login, prefer storage state over password login
SIMPLIFY_STORAGE_STATE=secrets/simplify_storage.json

# Simplify Job Tracker (NOT intern-list.com — that site is a discovery list)
# Open Simplify → Job Tracker, then paste the address-bar URL here.
SIMPLIFY_TRACKER_URL=https://simplify.jobs/dashboard
# Common alternates if the above 404s / redirects:
# SIMPLIFY_TRACKER_URL=https://simplify.jobs/jobs/applied
# SIMPLIFY_TRACKER_URL=https://simplify.jobs/applications

# Discovery sources (separate from tracker)
JOBRIGHT_URL=https://jobright.ai/jobs/recommend
# After: python3 scripts/automation/save_jobright_session.py
# JOBRIGHT_STORAGE_STATE=secrets/jobright_storage.json
# Board minisites (power intern-list.com / newgrad-jobs.com) — scraped by export_board_lists.py
# NEWGRAD_SWE_URL=https://jobright.ai/minisites-jobs/newgrad/us/swe?embed=true
# INTERN_SWE_URL=https://jobright.ai/minisites-jobs/intern/us/swe?embed=true
# Cadence: scheduled by the "Daily Job Discovery" Cursor Automation
# (see docs/automation/DAILY_JOB_DISCOVERY.md). Local sessions are for manual runs.
# Run: python3 scripts/automation/run_discovery.py

# Headless false while debugging
PLAYWRIGHT_HEADLESS=false
